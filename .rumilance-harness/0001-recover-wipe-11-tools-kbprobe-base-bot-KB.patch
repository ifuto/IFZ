diff --git a/src/main/java/com/rumilance/practice/kb/KbProbeProfile.java b/src/main/java/com/rumilance/practice/kb/KbProbeProfile.java
new file mode 100644
index 0000000..1952f52
--- /dev/null
+++ b/src/main/java/com/rumilance/practice/kb/KbProbeProfile.java
@@ -0,0 +1,288 @@
+package com.rumilance.practice.kb;
+
+import java.util.Map;
+
+/**
+ * kbprobe 1.0.0 の「kbprobe/1」プロファイル — 実測 Mod (dev.kbprobe) が出力する 14 個の
+ * 物理パラメータをそのまま保持し、近接 KB をこの式で組み立て直す。
+ *
+ * <p>式は Mod の {@code KbModel#predict} / {@code KbModel#fold} の逆コンパイル結果と一致させて
+ * ある (2026-10 検証)。grounded は計測条件つきで再現する (ヒットの {@code groundLagTicks}
+ * tick 前の接地フラグ、またはそこから {@code groundWindowTicks} tick のいずれか —
+ * {@link #isGrounded(boolean[])}):</p>
+ *
+ * <pre>
+ * resist = max(0, 1 - knockbackResistanceScale * victimKnockbackResistance)
+ * base   = (projectile ? baseStrengthProjectile : baseStrengthMelee) * resist
+ *        方向 = normalize(victim - source)  (反撃側から見た「押し出し」方向)
+ * extra  = (weaponStrength[手持ち] + (sprint ? sprintStrength : 0)) * resist
+ *        方向 = 攻撃者の向き (-sin yaw, cos yaw) / 強さ 0 なら段自体が無い
+ * 1 fold (段ごと):
+ *   vx = vx * horizontalFriction + dirX * s
+ *   vz = vz * horizontalFriction + dirZ * s
+ *   vy = grounded ? min(verticalLimit, vy*verticalFrictionGround + s*verticalScaleGround)
+ *                 : vy*verticalFrictionAir + s*verticalScaleAir
+ * singleFold (段をまとめるサーバ): push = base*away + extra*facing, s = base + extra で 1 回だけ fold
+ * mace shockwave (殴られた本人ではなく周囲): power = (radius - distance) * scale
+ *   * (fallDistance &gt; 5 ? heavyMultiplier : 1) * resist を加算
+ * </pre>
+ *
+ * <p>純 JDK (localtest でサーバ無しに検証できる)。</p>
+ */
+public record KbProbeProfile(
+		double horizontalFriction,
+		double verticalFrictionGround,
+		double verticalFrictionAir,
+		double verticalLimit,
+		double verticalScaleGround,
+		double verticalScaleAir,
+		double baseStrengthMelee,
+		double baseStrengthProjectile,
+		double sprintStrength,
+		double knockbackResistanceScale,
+		double maceShockwaveRadius,
+		double maceShockwaveScale,
+		double maceShockwaveVertical,
+		double maceShockwaveHeavyMultiplier,
+		Map<String, Double> weaponStrength,
+		boolean singleFold,
+		int sprintGate,
+		/**
+		 * 計測時の「接地フラグを見る遅れ (tick)」と「そこから遡って許す窓 (tick)」。
+		 * Mod は「ヒットの groundLagTicks 前の接地フラグ、またはそこから groundWindowTicks 分の
+		 * いずれか」を grounded としてフィットする。バニラは lag 0 / window 0 (ヒット tick のみ)。
+		 */
+		int groundLagTicks,
+		int groundWindowTicks) {
+
+	/** Mod の {@code KbModel.MAX_GROUND_WINDOW}。 */
+	public static final int MAX_GROUND_WINDOW = 3;
+
+	/** 旧シグネチャ (計測条件なし = バニラと同じ「ヒット tick の接地フラグ」)。 */
+	public KbProbeProfile(double horizontalFriction, double verticalFrictionGround,
+			double verticalFrictionAir, double verticalLimit, double verticalScaleGround,
+			double verticalScaleAir, double baseStrengthMelee, double baseStrengthProjectile,
+			double sprintStrength, double knockbackResistanceScale, double maceShockwaveRadius,
+			double maceShockwaveScale, double maceShockwaveVertical,
+			double maceShockwaveHeavyMultiplier, Map<String, Double> weaponStrength,
+			boolean singleFold, int sprintGate) {
+		this(horizontalFriction, verticalFrictionGround, verticalFrictionAir, verticalLimit,
+				verticalScaleGround, verticalScaleAir, baseStrengthMelee, baseStrengthProjectile,
+				sprintStrength, knockbackResistanceScale, maceShockwaveRadius, maceShockwaveScale,
+				maceShockwaveVertical, maceShockwaveHeavyMultiplier, weaponStrength, singleFold,
+				sprintGate, 0, 0);
+	}
+
+	/** kbprobe/1 のパラメータ名 (Mod の {@code KbModel.FIXED_NAMES} と同順)。 */
+	public static final String[] FIXED_NAMES = {
+			"horizontalFriction", "verticalFrictionGround", "verticalFrictionAir",
+			"verticalLimit", "verticalScaleGround", "verticalScaleAir",
+			"baseStrengthMelee", "baseStrengthProjectile", "sprintStrength",
+			"knockbackResistanceScale", "maceShockwaveRadius", "maceShockwaveScale",
+			"maceShockwaveVertical", "maceShockwaveHeavyMultiplier"};
+
+	/** Mod の FIXED_VANILLA (= Java 1.21.11 の実測基準値)。 */
+	public static final double[] FIXED_VANILLA = {
+			0.5d, 0.5d, 1.0d, 0.4d, 1.0d, 0.0d, 0.4d, 0.4d,
+			0.5d, 1.0d, 3.5d, 0.7d, 0.7d, 2.0d};
+
+	/** Mod の FIXED_LOWER / FIXED_UPPER (フィット範囲)。範囲外はここへ丸める。 */
+	public static final double[] FIXED_LOWER = {
+			0.0d, 0.0d, 0.0d, 0.0d, -4.0d, -4.0d, 0.0d, 0.0d,
+			0.0d, 0.0d, 0.0d, 0.0d, -4.0d, 0.0d};
+	public static final double[] FIXED_UPPER = {
+			2.0d, 2.0d, 2.0d, 8.0d, 8.0d, 8.0d, 8.0d, 8.0d,
+			8.0d, 4.0d, 16.0d, 8.0d, 8.0d, 16.0d};
+
+	/** weaponStrength 未計測の武器 (Mod の {@code WEAPON_VANILLA})。 */
+	public static final double WEAPON_VANILLA = 0.0d;
+
+	/** 計測前の初期構造: 2 段 fold・sprint gate 無し。 */
+	public static final boolean DEFAULT_SINGLE_FOLD = false;
+	public static final int DEFAULT_SPRINT_GATE = 0;
+
+	/** vanilla 1.21.11 を再現する既定値 (weaponStrength は空 = 全武器 0.0)。 */
+	public static final KbProbeProfile VANILLA = new KbProbeProfile(
+			FIXED_VANILLA[0], FIXED_VANILLA[1], FIXED_VANILLA[2], FIXED_VANILLA[3],
+			FIXED_VANILLA[4], FIXED_VANILLA[5], FIXED_VANILLA[6], FIXED_VANILLA[7],
+			FIXED_VANILLA[8], FIXED_VANILLA[9], FIXED_VANILLA[10], FIXED_VANILLA[11],
+			FIXED_VANILLA[12], FIXED_VANILLA[13], Map.of(),
+			DEFAULT_SINGLE_FOLD, DEFAULT_SPRINT_GATE);
+
+	public KbProbeProfile {
+		horizontalFriction = clampRange(0, horizontalFriction);
+		verticalFrictionGround = clampRange(1, verticalFrictionGround);
+		verticalFrictionAir = clampRange(2, verticalFrictionAir);
+		verticalLimit = clampRange(3, verticalLimit);
+		verticalScaleGround = clampRange(4, verticalScaleGround);
+		verticalScaleAir = clampRange(5, verticalScaleAir);
+		baseStrengthMelee = clampRange(6, baseStrengthMelee);
+		baseStrengthProjectile = clampRange(7, baseStrengthProjectile);
+		sprintStrength = clampRange(8, sprintStrength);
+		knockbackResistanceScale = clampRange(9, knockbackResistanceScale);
+		maceShockwaveRadius = clampRange(10, maceShockwaveRadius);
+		maceShockwaveScale = clampRange(11, maceShockwaveScale);
+		maceShockwaveVertical = clampRange(12, maceShockwaveVertical);
+		maceShockwaveHeavyMultiplier = clampRange(13, maceShockwaveHeavyMultiplier);
+		weaponStrength = weaponStrength == null ? Map.of() : Map.copyOf(weaponStrength);
+		if (sprintGate < 0) {
+			sprintGate = 0;
+		}
+		groundLagTicks = Math.max(0, groundLagTicks);
+		groundWindowTicks = Math.max(0, Math.min(MAX_GROUND_WINDOW, groundWindowTicks));
+	}
+
+	/**
+	 * 計測と同じ接地判定: {@code history} は 1 tick 1 要素で <b>末尾が最新</b>、
+	 * 最新がヒット tick。Mod の {@code KbModel.isGrounded} と同じく
+	 * {@code lag} tick 前のフラグから {@code window} tick 分のいずれかが接地なら true。
+	 * 履歴が短くて参照できないときは最新の値で代用する。
+	 */
+	public boolean isGrounded(boolean[] history) {
+		if (history == null || history.length == 0) {
+			return false;
+		}
+		int last = history.length - 1;
+		for (int k = 0; k <= groundWindowTicks; k++) {
+			int index = last - groundLagTicks + k;
+			if (index < 0 || index > last) {
+				continue;
+			}
+			if (history[index]) {
+				return true;
+			}
+		}
+		// 履歴が lag/window より短い場合は最新 (=ヒット tick) のフラグを使う。
+		return history[last];
+	}
+
+	private static double clampRange(int index, double value) {
+		if (Double.isNaN(value)) {
+			return FIXED_VANILLA[index];
+		}
+		return Math.max(FIXED_LOWER[index], Math.min(FIXED_UPPER[index], value));
+	}
+
+	/** 13 番目までの固定パラメータ (テスト・表示用)。 */
+	public double fixed(int index) {
+		return switch (index) {
+			case 0 -> horizontalFriction;
+			case 1 -> verticalFrictionGround;
+			case 2 -> verticalFrictionAir;
+			case 3 -> verticalLimit;
+			case 4 -> verticalScaleGround;
+			case 5 -> verticalScaleAir;
+			case 6 -> baseStrengthMelee;
+			case 7 -> baseStrengthProjectile;
+			case 8 -> sprintStrength;
+			case 9 -> knockbackResistanceScale;
+			case 10 -> maceShockwaveRadius;
+			case 11 -> maceShockwaveScale;
+			case 12 -> maceShockwaveVertical;
+			default -> maceShockwaveHeavyMultiplier;
+		};
+	}
+
+	/** その武器の計測値 (未計測は 0.0 = 追加段なし)。 */
+	public double weaponStrength(String weaponKey) {
+		if (weaponKey == null) {
+			return WEAPON_VANILLA;
+		}
+		return weaponStrength.getOrDefault(weaponKey, WEAPON_VANILLA);
+	}
+
+	/** Mod の resist 項: {@code max(0, 1 - knockbackResistanceScale * 耐性値)}。 */
+	public double resistScale(double knockbackResistance) {
+		double r = Math.max(0.0d, Math.min(1.0d, knockbackResistance));
+		return Math.max(0.0d, 1.0d - knockbackResistanceScale * r);
+	}
+
+	/**
+	 * Mod の {@code fold} 1 回分。速度配列を書き換えて返す。
+	 *
+	 * @param v        現在速度 {@code {x, y, z}} (書き換え)
+	 * @param pushX    水平の押し出し成分 (すでに resist 済み)
+	 * @param pushZ    水平の押し出し成分
+	 * @param strength 段の強さ (縦の倍率に使う / singleFold では base + extra)
+	 */
+	public double[] fold(double[] v, double pushX, double pushZ, double strength, boolean grounded) {
+		v[0] = v[0] * horizontalFriction + pushX;
+		v[2] = v[2] * horizontalFriction + pushZ;
+		if (grounded) {
+			v[1] = Math.min(verticalLimit,
+					v[1] * verticalFrictionGround + strength * verticalScaleGround);
+		} else {
+			v[1] = v[1] * verticalFrictionAir + strength * verticalScaleAir;
+		}
+		return v;
+	}
+
+	/** 近接 1 段目 (base) の強さ: {@code baseStrengthMelee * resist}。 */
+	public double baseStrength(double resist, boolean projectile) {
+		return (projectile ? baseStrengthProjectile : baseStrengthMelee) * resist;
+	}
+
+	/** 追加段 (extra) の強さ: {@code (weaponStrength + sprint) * resist}。 */
+	public double extraStrength(double resist, String weaponKey, boolean sprint) {
+		double weapon = weaponStrength(weaponKey);
+		double extra = weapon + (sprint ? sprintStrength : 0.0d);
+		return extra * resist;
+	}
+
+	/**
+	 * 1 ヒット分を予測する (Mod の predict のサーバ側版)。
+	 *
+	 * @param v           現在速度 (書き換えて返す)
+	 * @param awayX/awayZ 押し出し方向 (正規化済み)
+	 * @param baseStrength すでに resist 済みの base 段の強さ (0 なら段なし)
+	 * @param faceX/faceZ 攻撃者の向き (-sin yaw, cos yaw)
+	 * @param extraStrength すでに resist 済みの追加段の強さ (0 なら段なし)
+	 * @param grounded    ヒット時点の接地判定
+	 */
+	public double[] predict(double[] v, double awayX, double awayZ, double baseStrength,
+			double faceX, double faceZ, double extraStrength, boolean grounded) {
+		if (singleFold) {
+			if (baseStrength == 0.0d && extraStrength == 0.0d) {
+				return v;
+			}
+			double pushX = awayX * baseStrength + faceX * extraStrength;
+			double pushZ = awayZ * baseStrength + faceZ * extraStrength;
+			return fold(v, pushX, pushZ, baseStrength + extraStrength, grounded);
+		}
+		if (baseStrength != 0.0d) {
+			fold(v, awayX * baseStrength, awayZ * baseStrength, baseStrength, grounded);
+		}
+		if (extraStrength != 0.0d) {
+			fold(v, faceX * extraStrength, faceZ * extraStrength, extraStrength, grounded);
+		}
+		return v;
+	}
+
+	/**
+	 * mace の衝撃波 (smash の周囲の相手) — 加算式。
+	 *
+	 * @param fallDistance 攻撃者が落ちた距離 (5 超で heavy 倍率)
+	 * @param distance     爆心からの水平距離
+	 */
+	public double[] maceShockwave(double[] v, double dirX, double dirZ, double distance,
+			double fallDistance, double resist) {
+		double drop = maceShockwaveRadius - distance;
+		if (drop <= 0.0d) {
+			return v;
+		}
+		double heavy = fallDistance > 5.0d ? maceShockwaveHeavyMultiplier : 1.0d;
+		double power = drop * maceShockwaveScale * heavy * resist;
+		v[0] += dirX * power;
+		v[1] += maceShockwaveVertical;
+		v[2] += dirZ * power;
+		return v;
+	}
+
+	/** sprint 段を出すか: gate 0 は常に可、gap 0 (不明) も可、それ以外は gap &gt;= gate。 */
+	public boolean sprintCharged(int swingGapTicks) {
+		if (sprintGate <= 0 || swingGapTicks == 0) {
+			return true;
+		}
+		return swingGapTicks >= sprintGate;
+	}
+}
