+    // --------------------------------------------------------------------- duel
+    /**
+     * 相手 (偽プレイヤー) を 1 試合ぶん戦わせる: 遠ければ詰め、3.0 blk 以内で 1 発ずつ
+     * 殴る。ダメージは {@code damage(amount, attacker)} で与えるので、被弾処理
+     * (トーテム/無敵時間/装備による軽減) はすべて製品側の経路を通る。ノックバックは
+     * 参照の相手 (通常プレイヤー) と同じバニラ相当の押し出しを手で入れる — 練習 bot は
+     * 非 Player なので {@code EntityKnockbackEvent} のチューニング対象外であり、
+     * ここで速度を書かないと被弾しても位置が動かない。
+     */
+    private void tickDuel(String name, Player dummy) {
+        PacketBotBody body = dummies.get(name);
+        if (body == null) {
+            return;
+        }
+        PracticeSession session = practice.session(dummy.getUniqueId()).orElse(null);
+        BotBody bot = session == null ? null : session.combatBot();
+        if (bot == null || !bot.isValid() || bot.getWorld() != dummy.getWorld()) {
+            return;
+        }
+        Location botLoc = bot.getLocation();
+        Location me = dummy.getLocation();
+        double dist = botLoc.distance(me);
+        long now = System.currentTimeMillis();
+        // 遠ければ詰める (参照の相手は 40 % の時間を 2 blk 以内で過ごす)。
+        if (dist > DUEL_CHASE_RANGE) {
+            Vector to = botLoc.toVector().subtract(me.toVector()).setY(0);
+            if (to.lengthSquared() > 0.01d) {
+                dummy.setVelocity(to.normalize().multiply(0.22d)
+                        .setY(dummy.getVelocity().getY()));
+            }
+            return;
+        }
+        if (dist > DUEL_REACH || !bot.hasLineOfSight(dummy)) {
+            return;
+        }
+        if (now < duelNextAtMs.getOrDefault(name, 0L)) {
+            return;
+        }
+        // バニラの無敵時間: 連打しても 1 発ずつしか通らない (参照の被弾間隔も 0.6-1 s)。
+        org.bukkit.entity.LivingEntity living = bot.living();
+        if (living.getNoDamageTicks() > 0) {
+            return;
+        }
+        dummy.swingMainHand();
+        try {
+            living.damage(duelDamage, dummy);
+        } catch (Throwable t) {
+            log("duel damage failed: " + t.getClass().getSimpleName() + ": " + t.getMessage());
+            duel = false;
+            return;
+        }
+        Vector push = botLoc.toVector().subtract(me.toVector()).setY(0);
+        if (push.lengthSquared() > 0.0001d) {
+            push.normalize().multiply(0.4d).setY(0.36d);
+            bot.setVelocity(push);
+        }
+        // 参照の被弾間隔 (中央 0.90 s / p90 6.4 s) に寄せるため、1 発ごとに少し揺らす。
+        long jitter = java.util.concurrent.ThreadLocalRandom.current().nextLong(
+                Math.max(1L, duelCadenceMs / 2L));
+        duelNextAtMs.put(name, now + duelCadenceMs + jitter);
+    }
